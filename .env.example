# PORTA DO SERVIDOR DO VITE
VITE_PORT=

# CAMINHO BASE QUANDO O APP É SERVIDO EM UM SUBCAMINHO
BASE_PATH=

# ORIGEM DA API DO BACKEND EM DESENVOLVIMENTO
VITE_API_ORIGIN=

# ORIGEM DOS ARQUIVOS ESTÁTICOS /media EM DEV (proxy do Vite → VPS)
#VITE_MEDIA_ORIGIN=https://institutogastrocentro.com.br

# ORIGEM DA API DO BACKEND EM PRODUÇÃO (obrigatório para chamadas diretas ao Render, sem proxy da Vercel)
#VITE_API_ORIGIN=

# CHAVE DE TESTE DO GOOGLE RECAPTCHA V2 EM DESENVOLVIMENTO
VITE_RECAPTCHA_SITE_KEY=

# CHAVE SECRETA DO RECAPTCHA EM PRODUÇÃO
#VITE_RECAPTCHA_SITE_KEY=

# Vídeos das aulas usam embed Vimeo. Nenhuma variável de CDN/S3 é necessária no frontend.
# O player só é carregado na página da aula, após a API validar matrícula (GET /courses/:courseId/lessons/:lessonId/video).
