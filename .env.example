# PORTA DO SERVIDOR DO VITE
VITE_PORT=

# CAMINHO BASE QUANDO O APP É SERVIDO EM UM SUBCAMINHO
BASE_PATH=

# ORIGEM DA API DO BACKEND EM DESENVOLVIMENTO
VITE_API_ORIGIN=

# ORIGEM DA API DO BACKEND EM PRODUÇÃO (obrigatório para chamadas diretas ao Render, sem proxy da Vercel)
#VITE_API_ORIGIN=

# Upload de vídeo: padrão é PUT direto no bucket via URL pré-assinada (não usa /tmp do Render).
# Só habilite o fallback abaixo para debug local — passa o arquivo inteiro pelo backend.
#VITE_VIDEO_API_UPLOAD=true

# CHAVE DE TESTE DO GOOGLE RECAPTCHA V2 EM DESENVOLVIMENTO
VITE_RECAPTCHA_SITE_KEY=

# CHAVE SECRETA DO RECAPTCHA EM PRODUÇÃO
#VITE_RECAPTCHA_SITE_KEY=

# Hosts de CDN autorizados para playback HLS (separados por vírgula).
# Ex.: d111111abcdef8.cloudfront.net
#VITE_VIDEO_CDN_ALLOWED_HOSTS=


